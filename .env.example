# Frontend API base URL.
# Local development can keep this as /api and let vite.config.js proxy it.
# Production should use your deployed API URL, for example: https://your-api.example.com/api
VITE_API_URL=/api

# Optional: comma-separated read-only worker/API mirrors for qtip and top-search calls.
# VITE_WORKER_URL=https://worker-1.example.com/api,https://worker-2.example.com/api

# Local-only Vite proxy target for /api. This is not exposed to the browser.
# Start your HiAnime API server separately, then point this to that server origin.
VITE_API_PROXY_TARGET=http://localhost:4000

# M3U8 proxy prefix used by the player. Keep /m3u8-proxy?url= when using the local Vite proxy below.
VITE_M3U8_PROXY_URL=/m3u8-proxy?url=

# Optional dedicated proxy prefix for the HD-1 server. Leave blank to reuse VITE_M3U8_PROXY_URL.
VITE_HD_1_PROXY_URL=

# Local-only Vite proxy target for /m3u8-proxy. Use the origin of your m3u8 proxy server.
VITE_M3U8_PROXY_TARGET=http://localhost:4000
